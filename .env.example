# Copy to .env and fill in your own values. Never commit .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Server-only AI key — set ONE of these (first one found is used).
# FREE: create a key at https://console.groq.com/keys (no credit card)
GROQ_API_KEY=
# Optional alternatives:
OPENAI_API_KEY=
LOVABLE_API_KEY=

# Own-build modular IWSDK hands and explicit session-local AR table anchors
VITE_XR_INPUT=iwsdk
